<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SBWB third-party licenses</title>
<style>
  body { font: 14px/1.5 system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { font-size: 1.5rem; }
  h2 { font-size: 1.1rem; margin-top: 2.5rem; }
  pre { white-space: pre-wrap; background: #f5f5f3; padding: 1rem; border-radius: 4px; font-size: 12px; }
  ul { padding-left: 1.2rem; }
</style>
</head>
<body>
<h1>SBWB third-party licenses</h1>
<p>SBWB is MIT licensed. The Rust crates below are compiled into the application. Models, fonts, lexicons, PDFium and the npm packages are listed in <code>THIRD-PARTY-NOTICES.md</code>.</p>

<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
